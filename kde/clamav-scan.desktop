[Desktop Entry]
Type=Service
Name=ClamAV
Icon=clamav
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/all;inode/directory;
Actions=scan;scan-quarantine;

[Desktop Action scan]
Name=Scan for viruses with ClamAV
Icon=clamav
Exec=clamav-scan %F

[Desktop Action scan-quarantine]
Name=Scan and quarantine with ClamAV
Icon=clamav
Exec=clamav-scan-quarantine %F
